---
// Inner-page hero: H1 and lead on the left; optional media on the right.
interface Props { title: string; lead?: string; id?: string }
const { title, lead } = Astro.props;
const hasMedia = Astro.slots.has('media');
---
<section class:list={['page-hero', { 'has-media': hasMedia }]}>
	<div class="container page-hero-grid">
		<div class="page-hero-text">
			<h1>{title}</h1>
			{lead && <p class="lead">{lead}</p>}
			<slot />
		</div>
		{hasMedia && <div class="page-hero-media"><slot name="media" /></div>}
	</div>
</section>

<style>
	.page-hero { padding-block: var(--space-2xl) var(--space-xl); border-bottom: 1px solid var(--hairline); }
	.page-hero-grid { display: grid; gap: var(--space-xl); }
	.page-hero-text > * + * { margin-top: var(--space-l); }
	.page-hero h1 { max-width: 18ch; font-size: clamp(2.5rem, 4vw + 1rem, 4.25rem); }
	@media (min-width: 60rem) {
		.page-hero.has-media .page-hero-grid { grid-template-columns: 7fr 5fr; align-items: end; }
	}
</style>
