---
import { NAV, BLOG_URL } from '../consts';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
	<div class="container header-inner">
		<a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>
			<svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
				<rect x="1" y="1" width="30" height="30" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
				<path d="M5 22c4-7 18-7 22 0" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
			</svg>
			<span>AOSSI</span>
		</a>
		<nav class="nav-desktop" aria-label="Main">
			<ul role="list">
				{NAV.map((item) => (
					<li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
				))}
				<li><a href={BLOG_URL}>Blog</a></li>
			</ul>
		</nav>
		<button class="menu-btn" type="button" popovertarget="mobile-nav" aria-controls="mobile-nav">
			<Icon name="menu" />
			<span>Menu</span>
		</button>
	</div>
	<nav id="mobile-nav" class="nav-mobile" popover aria-label="Menu">
		<div class="nav-mobile-head">
			<span class="wordmark" aria-hidden="true">AOSSI</span>
			<button class="menu-btn" type="button" popovertarget="mobile-nav" popovertargetaction="hide">
				<Icon name="x" />
				<span>Close</span>
			</button>
		</div>
		<ul role="list">
			<li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
			{NAV.map((item) => (
				<li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
			))}
			<li><a href={BLOG_URL}>Blog</a></li>
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--ink) 92%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--hairline);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-l);
		min-height: 4rem;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		color: var(--text);
		font-weight: 800;
		font-size: 1.125rem;
		letter-spacing: 0.06em;
		text-decoration: none;
	}
	.wordmark:hover { color: var(--text); }
	.wordmark:hover .mark path { stroke: var(--accent-hover); }
	.mark { color: var(--field-border); }

	ul { list-style: none; padding: 0; display: flex; }
	.nav-desktop ul { gap: var(--space-2xs); }
	.nav-desktop a, .nav-mobile a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: 0.75rem;
		color: var(--muted);
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
		border-radius: var(--radius);
		transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
	}
	.nav-desktop a:hover, .nav-mobile a:hover { color: var(--text); background: var(--surface); }
	.nav-desktop a:active, .nav-mobile a:active { background: var(--raised); }
	.nav-desktop a[aria-current='page'], .nav-mobile a[aria-current='page'] {
		color: var(--text);
		box-shadow: inset 0 -2px 0 var(--accent);
	}

	.menu-btn {
		display: none;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0 0.875rem;
		font: inherit;
		font-size: 1rem;
		font-weight: 600;
		color: var(--text);
		background: var(--surface);
		border: 1px solid var(--field-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.menu-btn:hover { background: var(--raised); border-color: var(--text); }
	.menu-btn:active { transform: translateY(1px); }
	.menu-btn :global(svg) { width: 1.25rem; height: 1.25rem; }

	.nav-mobile {
		inset: 0 0 auto auto;
		width: min(22rem, 100vw);
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: var(--space-m) var(--gutter) var(--space-xl);
		background: var(--surface);
		color: var(--text);
		border: 0;
		border-left: 1px solid var(--hairline);
	}
	.nav-mobile::backdrop { background: rgb(0 0 0 / 0.6); }
	.nav-mobile-head { display: flex; justify-content: space-between; align-items: center; min-height: 3rem; margin-bottom: var(--space-l); }
	.nav-mobile .menu-btn { display: inline-flex; }
	.nav-mobile ul { flex-direction: column; gap: var(--space-2xs); }
	.nav-mobile a { width: 100%; font-size: 1.25rem; min-height: 52px; }
	.nav-mobile a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--accent); }

	@media (prefers-reduced-motion: no-preference) {
		.nav-mobile { transition: translate 220ms var(--ease-out), opacity 220ms var(--ease-out), display 220ms allow-discrete, overlay 220ms allow-discrete; translate: 0 0; opacity: 1; }
		@starting-style { .nav-mobile:popover-open { translate: 2rem 0; opacity: 0; } }
	}

	@media (max-width: 52rem) {
		.nav-desktop { display: none; }
		.header-inner > .menu-btn { display: inline-flex; }
	}
</style>
